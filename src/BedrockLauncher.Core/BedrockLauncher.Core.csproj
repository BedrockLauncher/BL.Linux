<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BedrockLauncher</RootNamespace>
    <AssemblyName>BedrockLauncher.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BedrockLauncher.UpdateProcessor\BedrockLauncher.UpdateProcessor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\lang\*.xaml" LogicalName="lang.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BedrockLauncher.Linux.Tests" />
  </ItemGroup>
</Project>
