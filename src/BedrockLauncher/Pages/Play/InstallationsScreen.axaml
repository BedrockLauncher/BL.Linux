<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:BedrockLauncher.Classes"
             xmlns:ui="using:BedrockLauncher.UI"
             xmlns:g="using:BedrockLauncher.Pages.General"
             xmlns:p="using:BedrockLauncher.Properties"
             x:Class="BedrockLauncher.Pages.Play.InstallationsScreen"
             x:Name="PageHost">
    <Grid RowDefinitions="80,*" Background="#FF303030" x:Name="Root" Classes="Disableable">
        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Seperator.Background}">
            <Grid Background="#FF303030" ColumnDefinitions="Auto,Auto,*,Auto,*,Auto,Auto">
                <StackPanel Grid.Column="2" Margin="10,0,10,10" VerticalAlignment="Center">
                    <TextBlock Foreground="White" Text="{DynamicResource GeneralSubtitles_Search}" Margin="0,0,0,4" FontWeight="Bold"/>
                    <ContentControl Theme="{StaticResource TextboxLikeFrame}" Height="30">
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Width="16" Height="16" Margin="7,0,0,0" Foreground="White" Data="{StaticResource SearchIconGeometry}"/>
                            <TextBox Grid.Column="1" Theme="{StaticResource BlankTextBox}" x:Name="SearchBox" Watermark="{DynamicResource InstallationsPage_SearchBar_Content}" TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </ContentControl>
                </StackPanel>
                <Separator Grid.Column="3" Classes="Vertical" Margin="0,10,0,10" VerticalAlignment="Stretch"/>
                <StackPanel Grid.Column="4" Margin="10,0,10,10" VerticalAlignment="Center">
                    <TextBlock Foreground="White" Text="{DynamicResource GeneralSubtitles_SortBy}" Margin="2,0,0,4" FontWeight="Bold"/>
                    <ComboBox x:Name="SortByComboBox" Theme="{StaticResource BlankComboBoxStyle}" Height="30" SelectionChanged="SortByComboBox_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource InstallationsPage_SortBy_LatestPlayed}"/>
                        <ComboBoxItem Content="{DynamicResource InstallationsPage_SortBy_Name}"/>
                        <ComboBoxItem Content="{DynamicResource InstallationsPage_SortBy_None}"/>
                    </ComboBox>
                </StackPanel>
                <Separator Grid.Column="5" Classes="Vertical" Margin="0,10,0,10" VerticalAlignment="Stretch"/>
                <StackPanel Grid.Column="6" Margin="10" VerticalAlignment="Center">
                    <TextBlock Foreground="White" Text="{DynamicResource GeneralSubtitles_Versions}" Margin="4,0,0,4" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Height="35">
                        <CheckBox x:Name="ShowReleasesCheckBox" Content="{DynamicResource GeneralText_Releases}" Margin="5,0,0,0" IsCheckedChanged="Filter_Changed"/>
                        <CheckBox x:Name="ShowBetasCheckBox" Content="{DynamicResource GeneralText_Betas}" Margin="5,0,0,0" IsCheckedChanged="Filter_Changed"/>
                        <CheckBox x:Name="ShowPreviewsCheckBox" Content="{DynamicResource GeneralText_Previews}" Margin="5,0,0,0" IsCheckedChanged="Filter_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Background="{DynamicResource ListBox.Static.Background}">
            <Grid Margin="10" Width="800" HorizontalAlignment="Center">
                <Button x:Name="NewInstallationButton" Content="{DynamicResource InstallationsPage_AddButton}" Height="30" Click="NewInstallationButton_Click"
                        HorizontalAlignment="Left" Theme="{StaticResource DialogButton}"/>
            </Grid>
            <ListBox Grid.Row="1" x:Name="InstallationsList" HorizontalAlignment="Center" Width="800" SelectionMode="Single" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="c:BLInstallation">
                        <Grid x:Name="InstallationEntry" ColumnDefinitions="400,*,350" RowDefinitions="Auto,10,Auto,10" Background="Transparent">
                            <Separator Grid.ColumnSpan="3" Margin="0"/>
                            <Grid Grid.Row="2" Margin="0,4,0,4" ColumnDefinitions="Auto,*">
                                <Image Source="{Binding IconPath_Full, Converter={x:Static ui:Conv.Image}}" Width="40" Height="40" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock FontSize="16" Foreground="{DynamicResource PrimaryText.Foreground}" FontWeight="SemiBold" Text="{Binding DisplayName_Full}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryText.Foreground}" FontWeight="SemiBold" Text="{Binding VersionName}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Classes="ButtonPanel" Orientation="Horizontal" Grid.Row="2" Grid.Column="2" Height="40" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Click="Play_Click" Content="{DynamicResource InstallationsPage_PlayButton}" Theme="{StaticResource DialogButton_Green}"
                                        IsEnabled="{Binding #PageHost.AllowEditing}"/>
                                <Button Click="Folder_Click" Theme="{StaticResource DialogButton}" ToolTip.Tip="Open folder">
                                    <PathIcon Width="16" Height="16" Foreground="White" Data="{StaticResource FolderIconGeometry}"/>
                                </Button>
                                <Button Click="MoveUp_Click" Theme="{StaticResource DialogButton}" IsVisible="{Binding #PageHost.ManualOrder}">
                                    <PathIcon Width="16" Height="16" Foreground="White" Data="{StaticResource UpArrowIcon}"/>
                                </Button>
                                <Button Click="MoveDown_Click" Theme="{StaticResource DialogButton}" IsVisible="{Binding #PageHost.ManualOrder}">
                                    <PathIcon Width="16" Height="16" Foreground="White" Data="{StaticResource DownArrowIcon}"/>
                                </Button>
                                <Button Click="More_Click" Theme="{StaticResource DialogButton}">
                                    <PathIcon Width="13" Height="3" Foreground="White" Data="{StaticResource ExpandableIcon}"/>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource GeneralText_Edit}" Click="Edit_Click" IsVisible="{Binding !ReadOnly}" IsEnabled="{Binding #PageHost.AllowEditing}"/>
                                            <MenuItem Header="{DynamicResource GeneralText_Delete}" Click="Delete_Click" IsVisible="{Binding !ReadOnly}" IsEnabled="{Binding #PageHost.AllowEditing}"/>
                                            <MenuItem Header="{DynamicResource GeneralText_Duplicate}" Click="Duplicate_Click" IsEnabled="{Binding #PageHost.AllowEditing}"/>
                                            <Separator/>
                                            <MenuItem Header="{DynamicResource GeneralText_Install}" Click="Install_Click" IsEnabled="{Binding #PageHost.AllowEditing}"/>
                                            <MenuItem Header="{DynamicResource GeneralText_Backup}" Click="Backup_Click" IsEnabled="{Binding #PageHost.AllowEditing}"/>
                                            <MenuItem Header="{DynamicResource GeneralText_Restore}" Click="Restore_Click" IsEnabled="{Binding #PageHost.AllowEditing}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <!-- The buttons show on hover / selection, like upstream's ButtonPanelVisibility triggers -->
                    <Style Selector="ListBoxItem StackPanel.ButtonPanel">
                        <Setter Property="Opacity" Value="0"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover StackPanel.ButtonPanel, ListBoxItem:selected StackPanel.ButtonPanel, ListBoxItem:focus-within StackPanel.ButtonPanel">
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>
            <g:ResultPanel Grid.Row="1" PanelType="NoContent" x:Name="NothingFound" IsVisible="False"/>
        </Grid>
    </Grid>
</UserControl>
