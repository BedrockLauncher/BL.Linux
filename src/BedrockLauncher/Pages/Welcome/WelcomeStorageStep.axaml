<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BedrockLauncher.Pages.Welcome.WelcomeStorageStep"
             Width="596" Height="254">
    <!-- WelcomePageTwo.xaml -->
    <Grid>
        <Border Background="#FF313131" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,55"/>
        <TextBlock HorizontalAlignment="Center" Text="{DynamicResource FirstLaunch_OneThingTitle}" Foreground="White" FontSize="24" Margin="0,30,0,0" FontWeight="Bold"/>
        <StackPanel VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Text="{DynamicResource FirstLaunch_OneThingSubtitle}" Foreground="White" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock Margin="42,10,0,0" Text="{DynamicResource FirstLaunch_InstallType_Header}" Classes="HeaderTextblock"/>
            <RadioButton x:Name="FixedRadioButton" IsChecked="True" Foreground="White" Content="{DynamicResource FirstLaunch_FixedInstall_Checkbox}" Margin="42,5,0,0" FontSize="13" IsCheckedChanged="Mode_Changed"/>
            <RadioButton x:Name="PortableRadioButton" Foreground="White" Content="{DynamicResource FirstLaunch_PortableInstall_Checkbox}" Margin="42,0,0,0" FontSize="13"/>
            <Border Height="32" Background="#FF131313" Width="512" HorizontalAlignment="Left" Margin="42,5,0,0" CornerRadius="4">
                <Grid x:Name="PathBox" ColumnDefinitions="*,Auto,Auto,Auto" Classes="Disableable">
                    <TextBox IsReadOnly="True" x:Name="StorageDirectoryTextBox" FontSize="14" Padding="10,4,5,3" BorderThickness="0" Background="Transparent"/>
                    <Button Grid.Column="1" Content="{DynamicResource GeneralSubtitles_Browse}" Click="Browse_Click" Margin="5" Background="Transparent" Foreground="White" Padding="6,0"/>
                    <Panel Grid.Column="2" Width="1" Background="Gray" Margin="2,5"/>
                    <Button Grid.Column="3" Content="{DynamicResource GeneralSubtitles_Reset}" Click="Reset_Click" Margin="5" Background="Transparent" Foreground="White" Padding="6,0"/>
                </Grid>
            </Border>
        </StackPanel>
        <StackPanel Margin="0,0,8,8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Click="Back_Click" Content="{DynamicResource FirstLaunch_BackButton}" Height="32" Theme="{StaticResource DialogButton}"/>
            <Button Click="Next_Click" Content="{DynamicResource FirstLaunch_NextButton}" Height="32" Theme="{StaticResource DialogButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
