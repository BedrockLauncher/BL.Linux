<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:BedrockLauncher.Pages.Settings"
             x:Class="BedrockLauncher.Pages.Welcome.WelcomePage">
    <UserControl.Background>
        <ImageBrush Source="avares://BedrockLauncher/Resources/images/bg/firstlaunchbackground.jpg" Stretch="UniformToFill"/>
    </UserControl.Background>
    <Grid Background="#7F000000">
        <s:LanguageCombobox HorizontalAlignment="Left" Margin="20" VerticalAlignment="Top" Width="220"/>
        <TextBlock Foreground="White" FontSize="11" FontWeight="Bold" Text="{DynamicResource MainWindow_Disclaimer}" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        <Border CornerRadius="2" Background="#FF262626" Width="600" Height="258" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ContentControl x:Name="WelcomePageFrame" Margin="2"/>
        </Border>
    </Grid>
</UserControl>
