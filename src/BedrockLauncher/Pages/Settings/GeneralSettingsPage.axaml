<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:BedrockLauncher.Pages.Settings"
             x:Class="BedrockLauncher.Pages.Settings.GeneralSettingsPage"
             Background="#FF1F1F1F">
    <ScrollViewer>
        <StackPanel Margin="0,0,0,20">
            <Border Margin="30,24,30,8" Padding="24,20" Background="#FF282828" BorderBrush="#FF4A4A4A" BorderThickness="1">
                <TextBlock Text="{DynamicResource SettingsTab_Title}" Foreground="White" FontFamily="{StaticResource MinecraftTen}" FontSize="32"/>
            </Border>
            <TextBlock Margin="42,30,0,0" Text="{DynamicResource GeneralSettingsScreen_LanguageSubtitle}" Classes="HeaderTextblock"/>
            <StackPanel Orientation="Horizontal" Margin="42,5,0,0">
                <s:LanguageCombobox FontSize="14"/>
                <Button Margin="12,0,0,0" VerticalAlignment="Center" Theme="{StaticResource LinkButton}" Content="Help translate on Crowdin" Click="Crowdin_Click" FontSize="13"/>
            </StackPanel>
            <TextBlock Margin="42,30,0,0" Text="{DynamicResource GeneralSettingsScreen_ThemeSubtitle}" Classes="HeaderTextblock"/>
            <s:ThemeCombobox HorizontalAlignment="Left" Margin="42,5,0,0" FontSize="14"/>
            <TextBlock Margin="42,30,0,10" Text="{DynamicResource GeneralSettingsScreen_LauncherSettingsSubtitle}" Classes="HeaderTextblock"/>
            <CheckBox x:Name="KeepAppx" Content="{DynamicResource GeneralSettingsScreen_KeepAppx}" Margin="42,0,0,10" Foreground="White" Click="Checkbox_Click"/>
            <CheckBox x:Name="KeepLauncherOpen" Content="{DynamicResource GeneralSettingsScreen_KeepLauncherOpen}" Margin="42,0,0,10" Foreground="White" Click="Checkbox_Click"/>
            <CheckBox x:Name="AnimatePageTransitions" Content="{DynamicResource GeneralSettingsScreen_AnimateTransitions}" Margin="42,0,0,10" Foreground="White" Click="Checkbox_Click"/>
            <CheckBox x:Name="FetchVersionsFromMicrosoftStore" Content="{DynamicResource GeneralSettingsScreen_FetchVersionsFromMicrosoftStore}" Margin="42,0,0,10" Foreground="White" Click="Checkbox_Click"/>

            <!-- GroupBox: launcher path options -->
            <Border Margin="30,22,30,0" HorizontalAlignment="Left" BorderThickness="2" BorderBrush="Gray" Padding="10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource GeneralSettingsScreen_PathOptions_LauncherOptions_Text}" Classes="HeaderTextblock"/>
                    <CheckBox x:Name="PortableModeCheckBox" Click="PortableMode_Click" Content="{DynamicResource GeneralSettingsScreen_PathOptions_PortableMode_Text}" Margin="0,10,0,0" Foreground="White"/>
                    <TextBlock Margin="0,22,0,0" Text="{DynamicResource GeneralSettingsScreen_PathOptions_PathSubtitle_Text}" Classes="HeaderTextblock"/>
                    <ContentControl Theme="{StaticResource TextboxLikeFrame}" Height="32" Width="512" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Grid x:Name="PathBox" ColumnDefinitions="*,Auto,Auto,Auto" Classes="Disableable">
                            <TextBox Theme="{StaticResource BlankTextBox}" IsReadOnly="True" x:Name="StorageDirectoryTextBox" FontSize="14" Padding="10,4,5,3"/>
                            <Button Grid.Column="1" Content="{DynamicResource GeneralSubtitles_Browse}" Click="Browse_Click" Margin="5" Background="Transparent" Foreground="White" Padding="6,0"/>
                            <Panel Grid.Column="2" Width="1" Background="Gray" Margin="2,5"/>
                            <Button Grid.Column="3" Content="{DynamicResource GeneralSubtitles_Reset}" Click="Reset_Click" Margin="5" Background="Transparent" Foreground="White" Padding="6,0"/>
                        </Grid>
                    </ContentControl>
                    <TextBlock Margin="3,10,0,0" Foreground="{DynamicResource PrimaryText.Foreground}" FontSize="13" Text="{DynamicResource GeneralSettingsScreen_PathOptions_Notice_Text}" TextWrapping="Wrap" MaxWidth="512" HorizontalAlignment="Left"/>
                    <Button Theme="{StaticResource DialogButton_Red}" x:Name="RestartButton" Content="{DynamicResource GeneralSettingsScreen_PathOptions_RestartButton_Text}" Click="Restart_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
