<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BedrockLauncher.Pages.Settings.AboutPage"
             Background="{DynamicResource Background.Secondary}">
    <!-- 1:1 with upstream AboutPage.xaml: founder card, TEAM grid, original developer, special thanks, build info -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0,6,14" x:Name="Root">
            <StackPanel.Styles>
                <Style Selector="TextBlock.Section">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                </Style>
            </StackPanel.Styles>
            <ContentControl x:Name="Founder" Margin="0,0,0,14"/>
            <TextBlock Text="TEAM" Classes="Section"/>
            <UniformGrid Columns="2" Margin="-4,0,-4,10" x:Name="Team"/>
            <TextBlock Text="{DynamicResource AboutPage_OriginallyDevelopedBy_Text}" Classes="Section"/>
            <ContentControl x:Name="Original" Margin="0,0,0,10"/>
            <TextBlock Text="{DynamicResource AboutPage_SpecialThanks_Text}" Classes="Section"/>
            <UniformGrid Columns="2" Margin="-4,0,-4,10" x:Name="Thanks"/>
            <TextBlock Text="LINUX" Classes="Section"/>
            <UniformGrid Columns="2" Margin="-4,0,-4,10" x:Name="Linux"/>
            <Border Background="#262626" Padding="10">
                <StackPanel>
                    <TextBlock Margin="0,5,0,0" Text="{DynamicResource GeneralSettingsScreen_UpdatesSubtitle}" Classes="HeaderTextblock"/>
                    <TextBlock x:Name="BuildText" Margin="0,0,0,15" Foreground="White"/>
                    <Button Margin="0,10,0,1" FontSize="14" Click="Releases_Click" Content="{DynamicResource LauncherNewsPage_CheckForUpdates}" Theme="{StaticResource LinkButton}"/>
                    <TextBlock Margin="0,12,0,0" Text="{DynamicResource MainWindow_Disclaimer}" Classes="HeaderTextblock" Foreground="{DynamicResource SecondaryText.Foreground}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
