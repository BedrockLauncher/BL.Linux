<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:BedrockLauncher.Classes"
             xmlns:ui="using:BedrockLauncher.UI"
             xmlns:g="using:BedrockLauncher.Pages.General"
             x:Class="BedrockLauncher.Pages.Settings.VersionsPage"
             x:Name="PageHost">
    <Grid RowDefinitions="156,*" Background="#FF1F1F1F" x:Name="Root" Classes="Disableable">
        <Border BorderThickness="0,0,0,1" BorderBrush="#FF555555" ClipToBounds="True">
            <Panel>
                <Image Source="avares://BedrockLauncher/Resources/images/bg/play_screen/1.21.130_mounts_of_mayhem.png" Stretch="UniformToFill" Opacity="0.32"/>
                <Rectangle Fill="#CC111111"/>
                <Grid Margin="24,18" ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource NewsScreen_JavaNDungeons_BedrockCheckbox}" Foreground="White" FontFamily="{StaticResource MinecraftTen}" FontSize="28"/>
                        <TextBlock Text="Install Store builds, import GDK builds, keep older versions ready, and switch from the Play page." Foreground="#FFE6E6E6" FontSize="13" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Height="35" Margin="0,18,0,0">
                            <StackPanel.Styles>
                                <Style Selector="CheckBox">
                                    <Setter Property="Margin" Value="5,0,0,0"/>
                                </Style>
                            </StackPanel.Styles>
                            <CheckBox x:Name="ShowReleases" Click="Filter_Click" Content="{DynamicResource GeneralText_Releases}"/>
                            <CheckBox x:Name="ShowBetas" Click="Filter_Click" Content="{DynamicResource GeneralText_Betas}"/>
                            <CheckBox x:Name="ShowPreviews" Click="Filter_Click" Content="{DynamicResource GeneralText_Previews}"/>
                            <CheckBox x:Name="ShowUWP" Click="Filter_Click" Content="UWP"/>
                            <CheckBox x:Name="ShowGDK" Click="Filter_Click" Content="GDK"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button FontSize="14" HorizontalAlignment="Right" x:Name="RefreshButton" Click="Refresh_Click" Content="{DynamicResource GeneralText_Refresh}" Theme="{StaticResource LinkButton}" Margin="0,2"/>
                        <Button FontSize="14" HorizontalAlignment="Right" x:Name="AddButton" Click="AddPackage_Click" Content="{DynamicResource Linux_ImportPackage}" Theme="{StaticResource LinkButton}" Margin="0,2"/>
                        <Button FontSize="14" HorizontalAlignment="Right" x:Name="ImportGdkButton" Click="ImportGdk_Click" Content="{DynamicResource Linux_ImportGdk}" Theme="{StaticResource LinkButton}" Margin="0,2"/>
                    </StackPanel>
                </Grid>
            </Panel>
        </Border>
        <Border Grid.Row="1" Margin="18" Background="#FF282828" BorderBrush="#FF4A4A4A" BorderThickness="1">
            <Panel>
                <ListBox x:Name="VersionsList" SelectionMode="Single" Padding="8" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="c:MCVersion">
                            <!-- Component_VersionItem.xaml -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                                <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Left">
                                    <Image Source="{Binding IconPath, Converter={x:Static ui:Conv.Image}}" Width="40" Height="40"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock FontSize="16" Foreground="{DynamicResource PrimaryText.Foreground}" FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryText.Foreground}" FontWeight="SemiBold" Text="{Binding InstallationSize}"/>
                                        <TextBlock FontSize="9" Foreground="{DynamicResource TertiaryText.Foreground}" FontWeight="SemiBold" Text="{Binding UUID}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Classes="ButtonPanel">
                                    <Button Click="Repair_Click" Content="{DynamicResource GeneralText_Repair}" Theme="{StaticResource DialogButton_Orange}" IsEnabled="{Binding !IsCustom}"/>
                                    <Button Click="Folder_Click" Theme="{StaticResource DialogButton}">
                                        <PathIcon Width="16" Height="16" Foreground="White" Data="{StaticResource FolderIconGeometry}"/>
                                    </Button>
                                    <Button Click="More_Click" Theme="{StaticResource DialogButton}">
                                        <PathIcon Width="13" Height="3" Foreground="White" Data="{StaticResource ExpandableIcon}"/>
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource GeneralText_Remove}" Click="Remove_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem StackPanel.ButtonPanel">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover StackPanel.ButtonPanel, ListBoxItem:selected StackPanel.ButtonPanel">
                            <Setter Property="IsVisible" Value="True"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
                <StackPanel x:Name="NothingFound" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="30">
                    <g:ResultPanel PanelType="NoContent" Background="Transparent" Height="150"/>
                    <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource SecondaryText.Foreground}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560"/>
                </StackPanel>
            </Panel>
        </Border>
    </Grid>
</UserControl>
