<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BedrockLauncher</RootNamespace>
    <AssemblyName>BedrockLauncher</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Resources/images/icons/launcher_icon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Minecraft Bedrock Launcher for Linux</Product>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Resources/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.HtmlRenderer" Version="11.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BedrockLauncher.Core\BedrockLauncher.Core.csproj" />
  </ItemGroup>
</Project>
