<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders every launcher screen headlessly (Skia) to PNG files. Usage: dotnet run [output folder] [locale] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BedrockLauncher\BedrockLauncher.csproj" />
  </ItemGroup>
</Project>
